# Backend environment variables
# Copy to .env and fill in your values

PORT=3001
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Redis — store de rate-limiting partagé (OBLIGATOIRE en production)
# Sans REDIS_URL le serveur retombe sur un Map en mémoire : le rate-limit
# n'est alors correct que sur une seule instance (invalide si l'app scale).
# Le store actif est journalisé au démarrage : "[server] Rate limit store: redis".
#
# Upstash (Render Dashboard > Marketplace > Upstash, ou console.upstash.com) :
#   REDIS_URL=rediss://default:<PASSWORD>@<ENDPOINT>.upstash.io:6379
#   -> "rediss://" = TLS. Récupérer le mot de passe via "View credentials".
#
# Render Key Value (service Key Value ajouté au Blueprint) :
#   REDIS_URL=redis://rediss:<PASSWORD>@<RENDER_KEY_VALUE_HOST>:6379
#   -> Render injecte aussi REDIS_HOST / REDIS_PORT / REDIS_USERNAME en interne ;
#      REDIS_URL n'est pas fourni automatiquement, le composer soi-même.
#
# Upstash/Render en réseau privé (URL interne, non TLS) :
#   REDIS_URL=redis://default:<PASSWORD>@<HOST_INTERNE>:6379
#
# Auto-hébergé / VPS :
#   REDIS_URL=redis://:<PASSWORD>@localhost:6379
REDIS_URL=
# Budget de temps de connexion avant repli sur le Map mémoire (défaut 3000).
# Évite qu'un Redis injoignable bloque le démarrage du serveur.
REDIS_CONNECT_TIMEOUT_MS=3000

# PayTech (Senegal payment gateway)
PAYTECH_API_KEY=your-paytech-api-key
PAYTECH_API_SECRET=your-paytech-api-secret
PAYTECH_ENV=test
PUBLIC_API_URL=https://your-backend.onrender.com
APP_URL=https://your-frontend.onrender.com

# Supabase (Postgres + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key