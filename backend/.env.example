# Backend environment variables
# Copy to .env and fill in your values

PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS: liste d'origines autorisées séparées par virgules (requis en production)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Emails admin (séparés par virgules) utilisés quand Supabase est indisponible
ADMIN_EMAILS=admin@hip.app

# PayTech (Senegal payment gateway)
PAYTECH_API_KEY=your-paytech-api-key
PAYTECH_API_SECRET=your-paytech-api-secret
PAYTECH_ENV=test
PUBLIC_API_URL=https://your-backend.onrender.com
APP_URL=https://your-frontend.onrender.com

# Supabase (Postgres + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hôtes autorisés pour la redirection PayTech (optionnel, défaut: *.paytech.sn)
PAYTECH_ALLOWED_REDIRECT_HOSTS=paytech.sn