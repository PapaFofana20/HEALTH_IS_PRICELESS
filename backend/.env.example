# Backend environment variables
# Copy to .env and fill in your values

PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS: liste d'origines autorisées séparées par virgules (requis en production)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Emails admin (séparés par virgules) utilisés quand Supabase est indisponible
ADMIN_EMAILS=admin@hip.app

# SasPay (https://docs.saspay.me — mobile money + carte, Afrique de l'Ouest/Centre)
# Clé secrète depuis app.saspay.me (Développeur) : sk_test_... en test, sk_live_... en prod.
SASPAY_API_KEY=sk_test_paste-your-key-here
# Secret de signature webhook (Webhooks → Changer le secret, copié à la création).
SASPAY_WEBHOOK_SECRET=paste-your-webhook-signing-secret-here
PUBLIC_API_URL=https://your-backend.onrender.com
APP_URL=https://your-frontend.onrender.com

# Supabase (Postgres + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hôtes autorisés pour la redirection SasPay (optionnel, défaut: *.saspay.me)
SASPAY_ALLOWED_REDIRECT_HOSTS=checkout.saspay.me,pay.saspay.me